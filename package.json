{
  "name": "opencode-optimised-toolings",
  "version": "6.5.1",
  "private": false,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./server": "./index.js",
    "./tui": "./packages/tui/bootstrap.js"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "A production-grade OpenCode IDE and optimized tooling plugin with filesystem, terminal, CBM, web, stealth, settings, and update-safe host enhancements.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrAlony/opencode-optimised-toolings.git"
  },
  "homepage": "https://github.com/MrAlony/opencode-optimised-toolings#readme",
  "bugs": {
    "url": "https://github.com/MrAlony/opencode-optimised-toolings/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "ide",
    "developer-tools",
    "mcp"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "workspaces": [
    "packages/filesystem",
    "packages/terminal",
    "packages/cbm",
    "packages/web",
    "packages/stealth",
    "packages/selfpatch",
    "packages/tui"
  ],
  "files": [
    "index.js",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "config/AGENTS.md",
    "config/runtime-dependencies.json",
    "npm-shrinkwrap.json",
    "packages/bootstrap/index.js",
    "packages/bootstrap/update.js",
    "packages/shared/paths.js",
    "packages/shared/generation.js",
    "packages/shared/deployment.js",
    "scripts/toolings.mjs",
    "packages/filesystem/index.js",
    "packages/filesystem/lib",
    "packages/filesystem/package.json",
    "packages/terminal/index.js",
    "packages/terminal/package.json",
    "packages/cbm/dist",
    "packages/cbm/package.json",
    "packages/cbm/README.md",
    "packages/cbm/SKILL.md",
    "packages/web/index.js",
    "packages/web/lib",
    "packages/web/package.json",
    "packages/stealth/index.js",
    "packages/stealth/lib",
    "packages/stealth/package.json",
    "packages/selfpatch/index.js",
    "packages/selfpatch/lib",
    "packages/selfpatch/patches",
    "packages/selfpatch/package.json",
    "packages/tui/index.tsx",
    "packages/tui/bootstrap.js",
    "packages/tui/package.json",
    "packages/tui/components",
    "packages/tui/lib"
  ],
  "scripts": {
    "build": "npm run build -w packages/cbm",
    "test": "node scripts/test-all.mjs",
    "test:root": "node --test test/*.test.mjs",
    "test:live": "node test/live-all-tools.mjs",
    "test:patch:e2e": "node packages/selfpatch/test/network/e2e-patch.test.mjs",
    "install:opencode": "node scripts/install.mjs",
    "uninstall:opencode": "node scripts/uninstall.mjs",
    "recover:opencode": "node scripts/recover-selfpatch.mjs",
    "doctor": "node scripts/toolings.mjs doctor",
    "toolings": "node scripts/toolings.mjs",
    "audit:engine": "node scripts/engine-audit.mjs",
    "verify:shareable": "node scripts/verify-shareable.mjs",
    "services": "node scripts/services.mjs",
    "setup": "node scripts/setup.mjs",
    "candidate:local": "node scripts/candidate-local.mjs",
    "release:local": "node scripts/release-local.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@opencode-ai/plugin": "1.18.13",
    "@opentui/solid": "0.4.5",
    "jsonc-parser": "3.3.1",
    "linkedom": "0.18.13",
    "patchright": "1.61.1",
    "pdf-parse": "1.1.4",
    "solid-js": "1.9.12",
    "tar": "7.5.22",
    "turndown": "7.2.4",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "bun": "^1.3.14"
  },
  "overrides": {
    "@babel/core": "7.29.7"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": ""
}
